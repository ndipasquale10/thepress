rules_version = '2';

// The Press -- Firestore security rules.
//
// Three collections, three different trust models:
//
//   users/{uid}         Private. A per-user mirror of what is already in that
//                       device's localStorage: saved player profiles (names,
//                       handicaps), saved courses, and full round history
//                       including money. Nobody but the owner ever reads it.
//
//   liveRounds/{code}   Capability-scoped. The document ID *is* the six-character
//                       share code the host reads out on the first tee, so
//                       holding the code is the whole permission model: you can
//                       fetch a round by its code, and you can never list the
//                       collection to discover codes you were not given. That is
//                       why `list` is denied outright rather than filtered -- a
//                       rule cannot see a query's `where` clause, so any rule
//                       permissive enough to allow "find the round whose code is
//                       ABC123" is equally permissive to "hand me every round."
//
//   sharedCourses/{slug} Public reference data. Any signed-in player may add a
//                       course from their scorecard and every player benefits.
//                       Validated on shape so a bad write cannot poison the
//                       course library, and never deletable.
//
// Deny-by-default is the last rule in the file: a collection nobody wrote a rule
// for is unreachable, not open.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ------------------------------------------------------------------
    // users/{uid} -- private, owner-only.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // liveRounds/{code} -- a round in progress, shared by code.
    // ------------------------------------------------------------------
    match /liveRounds/{code} {

      // Every field the app writes. An update's request.resource.data is the
      // merged post-state, so listing them here both rejects unknown fields and
      // stops a writer smuggling extra data into a round they merely joined.
      function liveFields() {
        return [
          'course', 'gameType', 'gameOpts', 'sideBets', 'players', 'pars',
          'hdcps', 'scores', 'wolfHoles', 'wolfBreakouts', 'bankerHoles',
          'bankerPresses', 'bonusPoints', 'pickedUp', 'matchPresses', 'holeCount',
          'holeStart', 'handicapMode', 'currentHole', 'owner', 'code',
          'updatedAt'
        ];
      }

      function shapedLikeARound() {
        return request.resource.data.keys().hasOnly(liveFields())
            && request.resource.data.keys().hasAll(['owner', 'code', 'players'])
            && request.resource.data.players is list
            && request.resource.data.players.size() >= 1
            && request.resource.data.players.size() <= 12;
      }

      // Payment handles stay on each player's own phone. This document is
      // readable by anyone with the code and writable by anyone who joined, so a
      // handle here could be read by a stranger or swapped for someone else's
      // and paid out by the next phone to open the round. An empty handle is
      // let through: the app has always written blank ones, and a phone still
      // on the previous version must be able to go live until it reloads.
      // Rules cannot loop, so each of the (at most 12) seats is checked in turn.
      function noHandles(p) {
        return p is map
            && p.get('venmo', '') == ''
            && p.get('cashapp', '') == ''
            && p.get('paypal', '') == '';
      }
      function seatClean(ps, i) {
        return ps.size() <= i || noHandles(ps[i]);
      }
      function rosterCarriesNoHandles() {
        let ps = request.resource.data.players;
        return seatClean(ps, 0) && seatClean(ps, 1) && seatClean(ps, 2)
            && seatClean(ps, 3) && seatClean(ps, 4) && seatClean(ps, 5)
            && seatClean(ps, 6) && seatClean(ps, 7) && seatClean(ps, 8)
            && seatClean(ps, 9) && seatClean(ps, 10) && seatClean(ps, 11);
      }

      // Only a write that touches the roster is held to that, so a round
      // published before handles were stripped can still be scored.
      function rosterUnchangedOrClean() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['players'])
            || rosterCarriesNoHandles();
      }

      // Knowing the code is the capability. Watch links (?watch=CODE) are opened
      // by people who may not have signed in yet, so a read by exact ID stays
      // open.
      allow get: if true;

      // Listing is only ever "show me my own rounds", which is what account
      // deletion needs to find the rounds it has to erase. Firestore will only
      // run a list whose constraints prove every result satisfies this rule, so
      // a query without `where('owner','==',uid)` -- including the old
      // scan-and-match-client-side join -- is refused outright.
      allow list: if signedIn() && resource.data.owner == request.auth.uid;

      // The host creates the round. The code in the body must match the document
      // ID, so the field the join query trusts cannot disagree with the address.
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.code == code
                    && code.matches('^[A-Z0-9]{6}$')
                    && shapedLikeARound()
                    && rosterCarriesNoHandles();

      // Anyone holding the code may keep score -- that is the point of sharing
      // it -- but they cannot take the round over or re-point its code.
      allow update: if signedIn()
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.code == resource.data.code
                    && shapedLikeARound()
                    && rosterUnchangedOrClean();

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // sharedCourses/{slug} -- the community course library.
    // ------------------------------------------------------------------
    match /sharedCourses/{slug} {

      // Mirrors the validation in scripts/build-courses.js, as far as rules can
      // express it: rules cannot walk a list's elements, so tees/pars/hdcps are
      // checked for shape and length and the app validates the contents.
      function validCourse() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'tees', 'pars', 'hdcps'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 120
            && (!('city' in d) || (d.city is string && d.city.size() <= 80))
            && (!('state' in d) || (d.state is string && d.state.size() <= 2))
            && d.tees is list && d.tees.size() >= 1 && d.tees.size() <= 12
            && d.pars is list && d.pars.size() == 18
            && d.hdcps is list && d.hdcps.size() == 18;
      }

      allow read: if signedIn();
      allow create, update: if signedIn() && validCourse();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Everything else.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
